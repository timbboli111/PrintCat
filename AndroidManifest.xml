<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.printcat.app">

    <!-- Permission dasar yang dibutuhkan Fyne dan PrintCat -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Bluetooth permissions untuk Android <= 11 -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- Bluetooth Scan untuk Android 12+ (active discovery) -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />

    <!-- Bluetooth Connect untuk Android 12+ (interaksi/koneksi) -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Location permission untuk Android 10-11 (diperlukan untuk scan) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <!-- Fitur Bluetooth (tidak wajib) -->
    <uses-feature android:name="android.hardware.bluetooth"
        android:required="false" />

</manifest>